rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.uid == 'WRYVYoxSxvbzK4PbiuLOJiHXsr72'; }
    function st() { return get(/databases/$(database)/documents/state/current).data; }

    match /voters/{id} {
      allow read: if admin() || (request.auth != null && request.auth.uid == id);
      allow write: if admin();
    }
    match /state/current { allow read: if request.auth != null; allow write: if admin(); }
    match /history/{id}  { allow read: if request.auth != null; allow write: if admin(); }
    match /ballots/{id} {
      allow read: if admin() || (request.auth != null && id.matches('ep[0-9]+_' + request.auth.uid));
      allow create, update: if request.auth != null
        && id == 'ep' + string(st().ep) + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/voters/$(request.auth.uid))
        && st().open == true
        && request.resource.data.ep == st().ep
        && request.resource.data.ranking.size() == st().cast.size()
        && request.resource.data.ranking.hasAll(st().cast);
    }
  }
}
